# Public app/backend authentication used by the Android app.
APP_API_KEY=change-me-to-a-long-random-value

# Twilio credentials. Keep these only on the server/hosting provider.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=replace-with-api-secret

# Needed to validate inbound webhook signatures from Twilio.
# This is the Auth Token from Twilio Console, not the API Secret above.
TWILIO_AUTH_TOKEN=replace-with-auth-token

# WhatsApp sender registered in Twilio.
TWILIO_WHATSAPP_FROM=+17726663894

# Optional. Comma-separated E.164 phone numbers allowed to create notes.
# Example: +17725550000,+13055550000
ALLOWED_SENDERS=

# Storage. Mount DATA_DIR to persistent storage in production.
DATA_DIR=./data

# Optional acknowledgement. false saves money/messages; true replies "Nota guardada."
ACK_ENABLED=false
